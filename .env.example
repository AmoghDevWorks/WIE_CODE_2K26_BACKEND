# Server Configuration
PORT=3000

# Google Workspace Integration (Google Sheets & Google Drive via Apps Script)
# The Google Spreadsheet ID where registrations will be recorded
SPREADSHEET_ID=your_google_spreadsheet_id_here

# The Google Drive Folder ID where team abstract PDFs will be saved
DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# The deployed Google Apps Script Web App URL (must end in /exec)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
